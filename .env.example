# FT-02: Enable local development only; use False when deployed.
DJANGO_DEBUG=True
# FT-02: Development example only; replace with a random secret when deployed.
DJANGO_SECRET_KEY=dev-only-insecure-fintrack-example-key
# FT-02: Comma-separated host names accepted by Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# FT-70: Comma-separated HTTPS origins allowed to submit cross-origin forms in production.
DJANGO_CSRF_TRUSTED_ORIGINS=
# FT-70: Enable only behind a correctly configured HTTPS reverse proxy.
DJANGO_SECURE_SSL_REDIRECT=False
# FT-70: Set a positive value only after HTTPS is live (for example 31536000).
DJANGO_SECURE_HSTS_SECONDS=0
# FT-70: Enable only if every subdomain uses HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# FT-70: Enable only after a deliberate HSTS preload review.
DJANGO_SECURE_HSTS_PRELOAD=False
# FT-02: Keep unset for SQLite; uncomment and replace when using PostgreSQL.
# DATABASE_URL=postgresql://fintrack:local-example-password@localhost:5432/fintrack
