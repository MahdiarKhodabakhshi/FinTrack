# FT-02: Enable local development only; use False when deployed.
DJANGO_DEBUG=True
# FT-02: Development example only; replace with a random secret when deployed.
DJANGO_SECRET_KEY=dev-only-insecure-fintrack-example-key
# FT-02: Comma-separated host names accepted by Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# FT-02: Leave blank for local SQLite; set a PostgreSQL URL when deployed.
DATABASE_URL=
